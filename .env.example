# Copy to .env and adjust. Values here override config.yaml.
# Format: STEAMWRAP_<SECTION>__<KEY>=value

# Alternate config file location
# STEAMWRAP_CONFIG_FILE=config.yaml

# STEAMWRAP_APP__ENVIRONMENT=production
# STEAMWRAP_APP__LOG_LEVEL=INFO
# STEAMWRAP_APP__LOG_JSON=true
# STEAMWRAP_APP__ALLOW_QUERY_TOKEN=false
# STEAMWRAP_APP__DOCS_ENABLED=false     # hide /docs, /redoc, /openapi.json
# STEAMWRAP_APP__CORS_ORIGINS=["https://your-frontend.example.com"]

# Optional Steam Web API key (https://steamcommunity.com/dev/apikey).
# Only used for the profile lookup in GET /me; everything else uses the
# caller's access token.
# STEAMWRAP_STEAM__API_KEY=

# STEAMWRAP_CACHE__LIBRARY_TTL_SECONDS=600
